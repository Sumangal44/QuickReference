<footer class="mt-16 md:mt-24 bg-gradient-to-b from-slate-100/60 via-slate-100/90 to-slate-200/90 dark:from-slate-900/60 dark:via-slate-900/90 dark:to-slate-950 text-slate-600 dark:text-slate-400 transition-colors duration-300">
    <% if (page.layout !== "note" && !page._isNotePagination) { %>
        <div class="max-container pt-12 pb-8 sm:pt-14 sm:pb-10 lg:pt-16 lg:pb-12">
            <!-- Responsive Grid: 1 col on mobile (<768px), 2 cols on tablet (768px-1024px), 3 cols on desktop (>=1024px) -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
                
                <!-- Column 1: Brand, Tagline & Navigation -->
                <div class="flex flex-col justify-between space-y-6 md:col-span-2 lg:col-span-1">
                    <div>
                        <div class="mb-4">
                            <%- partial('_partial/index/logo', { icon: true, theme: 'light', showText: true }) %>
                        </div>
                        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-sm">
                            Open-source cheat sheets, programming references, and keyboard shortcuts crafted for developers and creators.
                        </p>
                    </div>

                    <!-- Quick Navigation Badges -->
                    <div>
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-2.5">
                            Quick Links
                        </span>
                        <div class="flex flex-wrap gap-2">
                            <a href="/about/" title="About QuickReference" class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-medium bg-white/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 hover:text-indigo-600 dark:hover:text-indigo-400 shadow-sm transition-all duration-200">
                                About
                            </a>
                            <a href="/notes/" title="Developer Notes" class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-medium bg-white/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 hover:text-indigo-600 dark:hover:text-indigo-400 shadow-sm transition-all duration-200">
                                Notes
                            </a>
                            <a href="/support/" title="Support Project" class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-medium bg-white/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 hover:text-indigo-600 dark:hover:text-indigo-400 shadow-sm transition-all duration-200">
                                ☕ Support
                            </a>
                            <a href="https://github.com/Fechin/reference" target="_blank" rel="noopener noreferrer" title="Contribute on GitHub" class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-medium bg-white/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 hover:text-indigo-600 dark:hover:text-indigo-400 shadow-sm transition-all duration-200">
                                ⭐ GitHub
                            </a>
                        </div>
                    </div>

                    <!-- Social / Share Links -->
                    <div>
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-2.5">
                            Share & Connect
                        </span>
                        <div class="flex items-center">
                            <%- partial('share', { extra: 'justify-start' }) %>
                        </div>
                    </div>
                </div>

                <!-- Column 2: Top Cheatsheets -->
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-slate-100 mb-4 flex items-center gap-2">
                        <span class="p-1.5 rounded-lg bg-indigo-500/10 text-indigo-600 dark:bg-indigo-400/15 dark:text-indigo-400">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.527.82-1.131 1.904-1.72 3.205-.576 1.272-1.121 2.658-1.572 3.978-.445 1.306-.798 2.502-.99 3.425a6.002 6.002 0 005.155 7.18 5.977 5.977 0 005.81-4.733 5.992 5.992 0 00-.73-4.636c-.457-.753-.984-1.397-1.442-1.954-.455-.552-.84-1.02-1.077-1.385-.24-.368-.31-.564-.325-.668a1.002 1.002 0 00-.289-.912zm-3.23 8.358c.28-.77.587-1.564.912-2.35.313-.758.64-1.492.96-2.17.205.328.455.702.735 1.042.493.599 1.08 1.314 1.597 2.167.433.714.582 1.542.42 2.37a4.004 4.004 0 01-3.87 3.15 4.005 4.005 0 01-3.447-4.804c.14-.668.396-1.546.693-2.405z" clip-rule="evenodd" />
                            </svg>
                        </span>
                        Top Cheatsheets
                    </h3>
                    <div class="space-y-3">
                        <% 
                        const topPostsData = topPosts(3);
                        topPostsData.forEach(function(post) { 
                            const iconName = post.slug || (post.icon ? post.icon.replace(/^icon-/, '') : '') || (post.path ? post.path.replace(/\.html$/, '').replace(/^\//, '') : '');
                        %>
                            <a href="<%- url_for(post.path) %>" title="<%= post.title %> Cheatsheet - Popular Quick Reference" class="group flex items-center p-3 bg-white/90 dark:bg-slate-800/80 hover:bg-white dark:hover:bg-slate-800 rounded-xl shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">
                                <div class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0 mr-3 bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 group-hover:scale-110 transition-transform duration-200 [&>svg]:w-5 [&>svg]:h-5">
                                    <%- icon(iconName) %>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <h4 class="font-medium text-sm text-slate-900 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 truncate">
                                        <%= post.title %> <span class="text-xs font-normal text-slate-400 dark:text-slate-500">Cheatsheet</span>
                                    </h4>
                                    <p class="text-xs text-slate-500 dark:text-slate-400 truncate"><%= post.intro ? post.intro.slice(0, 45) + '...' : 'Popular Quick Reference' %></p>
                                </div>
                                <svg class="w-4 h-4 text-slate-400 opacity-0 group-hover:opacity-100 group-hover:translate-x-1 group-hover:text-indigo-500 transition-all duration-200 ml-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                </svg>
                            </a>
                        <% }); %>
                    </div>
                </div>

                <!-- Column 3: Recent Cheatsheets -->
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-slate-100 mb-4 flex items-center gap-2">
                        <span class="p-1.5 rounded-lg bg-emerald-500/10 text-emerald-600 dark:bg-emerald-400/15 dark:text-emerald-400">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                            </svg>
                        </span>
                        Recent Cheatsheets
                    </h3>
                    <div class="space-y-3">
                        <% 
                        const recentPosts = site.posts.sort('date', -1).filter(post => post.layout !== "note").data.slice(0, 3);
                        recentPosts.forEach(function(post) { 
                            const iconName = post.slug || (post.icon ? post.icon.replace(/^icon-/, '') : '') || (post.path ? post.path.replace(/\.html$/, '').replace(/^\//, '') : '');
                        %>
                            <a href="<%- url_for(post.path) %>" title="<%= post.title %> Cheatsheet - Latest Quick Reference" class="group flex items-center p-3 bg-white/90 dark:bg-slate-800/80 hover:bg-white dark:hover:bg-slate-800 rounded-xl shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">
                                <div class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0 mr-3 bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 group-hover:scale-110 transition-transform duration-200 [&>svg]:w-5 [&>svg]:h-5">
                                    <%- icon(iconName) %>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <h4 class="font-medium text-sm text-slate-900 dark:text-slate-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 truncate">
                                        <%= post.title %> <span class="text-xs font-normal text-slate-400 dark:text-slate-500">Cheatsheet</span>
                                    </h4>
                                    <p class="text-xs text-slate-500 dark:text-slate-400 truncate"><%= post.intro ? post.intro.slice(0, 45) + '...' : 'Latest Quick Reference' %></p>
                                </div>
                                <svg class="w-4 h-4 text-slate-400 opacity-0 group-hover:opacity-100 group-hover:translate-x-1 group-hover:text-emerald-500 transition-all duration-200 ml-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                </svg>
                            </a>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Bottom Bar / Copyright -->
    <div class="py-6 bg-slate-200/30 dark:bg-slate-950/60">
        <div class="max-container flex flex-col sm:flex-row items-center justify-between gap-4">
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 text-center sm:text-left">
                © <%= new Date().getFullYear() %> <span class="font-semibold text-slate-700 dark:text-slate-300">QuickReference</span>. All rights reserved.
            </p>
            <div class="flex items-center gap-4 text-xs sm:text-sm">
                <a href="/about/" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">About</a>
                <span class="text-slate-400/50 dark:text-slate-600">•</span>
                <a href="/support/" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Support</a>
                <span class="text-slate-400/50 dark:text-slate-600">•</span>
                <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-white/80 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 shadow-sm transition-all duration-200 cursor-pointer" title="Back to top">
                    <span>Top</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</footer>
